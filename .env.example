# Telegram bot config
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=123456789
# Optional aliases
TELEGRAM_CHAT_ID_PERSONAL=123456789
TELEGRAM_CHAT_ID_TEAM=-1001234567890

# IMAP mailbox config (Gmail recommended)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-gmail-address@gmail.com
IMAP_APP_PASSWORD=replace_with_16_char_gmail_app_password

# Watcher behavior
POLL_SECONDS=30
LOG_LEVEL=INFO

# Optional: custom state file path
# STATE_PATH=/home/dietpi/.codex/skills/send-to-telegram/state/livetrack_state.json
