# Telegram bot config
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_IDS=replace_with_chat_id,replace_with_second_chat_id
# Configured chats can send /disable or /enable to pause or resume their own alerts.
# Optional aliases for logging only: chat_id=alias,chat_id=alias
TELEGRAM_RECIPIENT_ALIASES=replace_with_chat_id=primary,replace_with_second_chat_id=backup
# Legacy single-recipient fallback (optional if TELEGRAM_CHAT_IDS is set)
# TELEGRAM_CHAT_ID=replace_with_single_chat_id

# IMAP mailbox config (Gmail recommended)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email-address@example.com
IMAP_APP_PASSWORD=replace_with_16_char_gmail_app_password

# Watcher behavior
POLL_SECONDS=30
LOG_LEVEL=INFO

# Optional: custom state file path
# STATE_PATH=/absolute/path/to/garminlivetrack-watcher/state/livetrack_state.json
