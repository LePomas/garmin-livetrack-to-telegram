# Telegram bot config
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_IDS=-814365864,-1001440633951,7748310522
# Optional aliases for logging only: chat_id=alias,chat_id=alias
TELEGRAM_RECIPIENT_ALIASES=-814365864=sniperimp_monkeys,-1001440633951=family,7748310522=ana
# Legacy single-recipient fallback (optional if TELEGRAM_CHAT_IDS is set)
# TELEGRAM_CHAT_ID=123456789

# IMAP mailbox config (Gmail recommended)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-gmail-address@gmail.com
IMAP_APP_PASSWORD=replace_with_16_char_gmail_app_password

# Watcher behavior
POLL_SECONDS=30
LOG_LEVEL=INFO

# Optional: custom state file path
# STATE_PATH=/home/dietpi/garminlivetrack-watcher/state/livetrack_state.json
