[Unit]
Description=Garmin LiveTrack Email to Telegram Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dietpi/garminlivetrack-watcher
ExecStart=/usr/bin/env python3 /home/dietpi/garminlivetrack-watcher/scripts/livetrack_watcher.py
Restart=always
RestartSec=5
EnvironmentFile=/home/dietpi/garminlivetrack-watcher/.env

[Install]
WantedBy=multi-user.target
